@echo off
REM -------------------------------------------------------------------
REM  start-backend.local.bat
REM  本地开发用的真实密钥(不进 GitHub 仓库,已被 .gitignore 屏蔽)。
REM  复制本文件为 start-backend.local.bat 并填入本地值即可。
REM -------------------------------------------------------------------

rem 本地 MySQL 密码(只在本机 dev 库使用,不要把强密码写在这里)
if not defined DB_PASSWORD set DB_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD

rem 本地 dev 用 JWT 签名密钥,用 openssl rand -base64 64 生成
if not defined BLOG_JWT_SECRET set BLOG_JWT_SECRET=REPLACE_WITH_LOCAL_OPENSSL_RAND_BASE64_64